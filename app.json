{
  "expo": {
    "name": "Ruby",
    "slug": "ruby",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ruby",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.pascalmmk.ruby",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#140A0E",
        "foregroundImage": "./assets/images/ruby-gem.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#140A0E",
          "image": "./assets/images/ruby-gem.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C0182F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7df5575e-7b36-4da1-be78-a5a60b81837a"
      }
    },
    "owner": "pascalmk"
  }
}
