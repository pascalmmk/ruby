{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "source": "/sw.js"
    }
  ]
}
