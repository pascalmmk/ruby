# Copy this file to .env and fill in the values from your Supabase project
# Project Settings -> Data API (URL) and Project Settings -> API Keys (anon/public key)
# These EXPO_PUBLIC_ vars are bundled into the client, which is fine: the anon key
# is designed to be public and is protected by Row-Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
